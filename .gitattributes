# MetaSec 原始材料是二进制，APK 超过 GitHub 普通文件 100MB 限制。
# 用 Git LFS 保留提交历史，同时避免普通 git 对大二进制做 diff。
materials/**/*.apk filter=lfs diff=lfs merge=lfs -text
materials/**/*.so filter=lfs diff=lfs merge=lfs -text
materials/**/*.i64 filter=lfs diff=lfs merge=lfs -text
materials/**/*.idb filter=lfs diff=lfs merge=lfs -text

# 可复用设备侧工具/payload 也是二进制，走 LFS，避免普通 git 仓库膨胀。
# 注意不要把 README.md 放进 LFS，GitHub 上需要直接可读。
tools/runtime_payloads/rustfrida filter=lfs diff=lfs merge=lfs -text
tools/runtime_payloads/*.so filter=lfs diff=lfs merge=lfs -text
tools/runtime_payloads/*.kpm filter=lfs diff=lfs merge=lfs -text
