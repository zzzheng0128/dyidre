# macOS / Python cache
.DS_Store
__pycache__/
*.py[cod]

# 归档目录只保留 _archive/README.md 作为说明。
# 里面的 1GB raw trace、boot 镜像、runtime payload 都不适合推公共仓库。
_archive/**
!_archive/
!_archive/README.md

# smoke_* 是脚本自测输出，可重新生成；真正基准 run 保留在非 smoke 目录。
runs/**/smoke_*/

# 进程号/临时状态文件。
*.pid
.last_*
current_*_ts.txt
